        <mxCell id="group_ingest" value="Phase 1: Ingestion Pipeline" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontStyle=1;startSize=26;" vertex="1" parent="1">
