        <mxCell id="box_ops" value="Order Operations Subagent Tools (SQLAlchemy ORM)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;startSize=26;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="320" width="600" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tool_status" value="get_order_status(order_id)&lt;br&gt;Reads current order status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="box_ops">
          <mxGeometry x="20" y="40" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tool_policy" value="check_refund_eligibility(order_id)&lt;br&gt;Guards: 30-day window &amp;amp; $500 threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="box_ops">
          <mxGeometry x="310" y="40" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tool_cancel" value="cancel_order(order_id)&lt;br&gt;Sets status to 'Cancelled'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="box_ops">
          <mxGeometry x="20" y="105" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tool_refund" value="process_refund(order_id)&lt;br&gt;Sets status to 'Refunded'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="box_ops">
          <mxGeometry x="310" y="105" width="270" height="50" as="geometry" />
        </mxCell>

        <mxCell id="rel_tools_orders" edge="1" parent="1" source="box_ops" target="tbl_orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;strokeDasharray=4 4;endArrow=classic;">
          <mxGeometry relative="1" as="geometry" />
