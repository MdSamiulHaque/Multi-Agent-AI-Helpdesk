        <mxCell id="c_field_4" value="    join_date   : DATETIME" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontColor=#000000;" vertex="1" parent="tbl_customers">
          <mxGeometry y="120" width="240" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tbl_orders" value="&lt;b&gt;orders&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="360" y="65" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="o_field_1" value="PK  order_id    : INTEGER" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontStyle=1;fontFamily=Courier New;fontSize=11;fontColor=#000000;" vertex="1" parent="tbl_orders">
          <mxGeometry y="30" width="250" height="30" as="geometry" />
