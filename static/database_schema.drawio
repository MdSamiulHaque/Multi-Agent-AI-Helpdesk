          <mxGeometry y="150" width="250" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tbl_products" value="&lt;b&gt;products&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1">
