        <mxCell id="o_field_2" value="FK  customer_id : INTEGER" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" parent="tbl_orders">
          <mxGeometry y="60" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="o_field_3" value="FK  product_id  : INTEGER" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" parent="tbl_orders">
          <mxGeometry y="90" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="o_field_4" value="    status      : TEXT NOT NULL" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontColor=#000000;" vertex="1" parent="tbl_orders">
          <mxGeometry y="120" width="250" height="30" as="geometry" />
