<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram name="Data-Model-Schema" id="db_schema_diag">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="tbl_customers" value="&lt;b&gt;customers&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_field_1" value="PK  customer_id : INTEGER" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontStyle=1;fontFamily=Courier New;fontSize=11;fontColor=#000000;" vertex="1" parent="tbl_customers">
          <mxGeometry y="30" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_field_2" value="    first_name  : TEXT NOT NULL" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontColor=#000000;" vertex="1" parent="tbl_customers">
          <mxGeometry y="60" width="240" height="30" as="geometry" />
