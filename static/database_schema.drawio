        <mxCell id="rel_cust_ord" edge="1" parent="1" source="c_field_1" target="o_field_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;">
